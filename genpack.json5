{
    profile: "paravirt",
    packages: [
        "dev-lang/php",
        "dev-php/PEAR-PEAR",
        "dev-php/pecl-imagick",
        "dev-php/pecl-redis",
        "dev-php/pecl-apcu",
        "dev-db/mysql", 
        "mail-mta/postfix",
        "media-video/ffmpeg",
        "dev-db/redis",
        "net-fs/samba", // for php-smbclient
        "net-analyzer/zabbix",
        "dev-util/trace-cmd",
        "net-libs/nodejs",
        "dev-vcs/git",

        "net-vpn/frp"
    ],
    accept_keywords: {
        "net-vpn/frp": null,
    },
    use:{
        "dev-lang/php": "apache2 bcmath truetype xmlreader gd sysvipc sockets xmlwriter mysqli fpm gd mysql -postgres xslt zip pdo pcntl sysvipc curl sqlite sharedmem tidy exif -cjk intl ldap ftp gmp imap soap sodium",
        "app-eselect/eselect-php": "apache2 fpm",
        "www-servers/apache": "APACHE2_MODULES: http2 proxy proxy_connect proxy_http proxy_ajp proxy_fcgi remoteip",
        "media-libs/gd": "truetype",
        "net-libs/nodejs": "npm",
        "net-analyzer/zabbix": "curl -frontend -mysql proxy -server snmp openipmi ssh libxml2 -postgres  sqlite",
        "net-analyzer/fping":"suid",
        "dev-libs/jemalloc": "stats",
        "media-libs/libheif": "x265",
        "media-gfx/imagemagick": "heif -openmp", // pecl-imagick requests openmp to be disabled
        "media-video/ffmpeg": "mp3 xvid x264 x265 vpx theora truetype v4l vorbis webp vdpau fontconfig librtmp"
    },
    license:{
        "net-analyzer/fping":"fping",
        "dev-db/redis": "SSPL-1"
    },
    services:["apache2", "mysqld", "postfix", "redis"],
    setup_commands: [
        "sed -i 's/-D SSL //' /etc/conf.d/apache2",
        "echo '*/5 * * * * php -f /var/www/localhost/htdocs/cron.php' | crontab -u apache -"
    ],
    variants: {
        "31": {
        },
        "selftestable": {
            profile: "weston/paravirt",
            circulardep_breaker: {
                packages: [ "media-libs/freetype", "media-libs/harfbuzz" ],
                use: "-truetype -harfbuzz"
            },
            packages: [
                "www-client/google-chrome",
                "media-fonts/vlgothic",
            ],
            license:{
                "www-client/google-chrome": "google-chrome"
            },
            users: [
                {
                    name: "user",
                    uid: 1000,
                    additional_groups: [ "wheel", "pcap" ],
                    empty_password: true,
                }
            ],
        }
    }
}

